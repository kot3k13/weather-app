# syntax=docker/dockerfile:1

FROM golang:alpine AS builder

RUN apk add --no-cache git openssh-client ca-certificates

WORKDIR /app

RUN mkdir -p -m 0700 ~/.ssh && ssh-keyscan github.com >> ~/.ssh/known_hosts

RUN --mount=type=ssh \
    git clone git@github.com:kot3k13/weather-app.git .

RUN go mod init weatherapp && \
    CGO_ENABLED=0 go build -ldflags="-w -s" -o weatherapp .

FROM scratch

LABEL org.opencontainers.image.authors="Kacper Kot"

COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=builder /app/weatherapp /weatherapp

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s \
  CMD ["/weatherapp", "-health"]

CMD ["/weatherapp"]